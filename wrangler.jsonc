{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vault-break",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "VaultRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VaultRoom"] }
  ],
  "observability": { "enabled": true }
}
